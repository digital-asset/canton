# for local dev runs this has to be 'true'
export IS_LOCAL_DEV_RUN="true"
# To avoid java.lang.OutOfMemoryError: Metaspace, we need to raise the MaxMetaspaceSize
export SBT_JVM_FLAGS="-J-Xmx10G -J-Xms4G -J-XX:MaxMetaspaceSize=4G -J-XX:+UnlockDiagnosticVMOptions -J-XX:+ClassUnloading -J-XX:+UseG1GC"
# sbt clean might take minutes, in local runs we want to skip it
export SKIP_SBT_CLEAN="true"

# Define base output directories
# These derived paths depend on RUN_ID and CURRENT_JOB_NAME already being set when this file is sourced
# If you don't follow the call order, please make sure the dependent vars are set
export DATA_DIR="/var/tmp/nightly-tests/$RUN_ID"
export LOGS_DIR="$DATA_DIR/logs"
export METRICS_BASE_DIR="$DATA_DIR/metrics"
export METRICS_DIR="$METRICS_BASE_DIR/$CURRENT_JOB_NAME"
export RECORDINGS_DIR="$DATA_DIR/recordings"
export PIDS_DIR="$DATA_DIR/pids"

# Re-export derived log file paths so they don't hold the old relative ./nightly-tests/ paths loaded from default-settings
export SYNCHRONIZERS_LOG_FILE="$LOGS_DIR/synchronizers-$CURRENT_JOB_NAME.log"
export SYNCHRONIZERS_SEC_LOG_FILE="$LOGS_DIR/synchronizers-sec-$CURRENT_JOB_NAME.log"
export PARTICIPANTS_LOG_FILE="$LOGS_DIR/participants-$CURRENT_JOB_NAME.log"
export PARTICIPANTS_SEC_LOG_FILE="$LOGS_DIR/participants-sec-$CURRENT_JOB_NAME.log"
export PERFORMANCE_RUNNERS_LOG_FILE="$LOGS_DIR/performance-runners-$CURRENT_JOB_NAME.log"

# Re-export COMMON_JAVA_OPTS so -XX:ErrorFile uses the new absolute LOGS_DIR
export COMMON_JAVA_OPTS="-Xmx10G -Xms4G -Xss2M -XX:MaxMetaspaceSize=4G -XX:ErrorFile=$LOGS_DIR/hs_err_pid%p.log -Dscala.concurrent.context.maxThreads=10 -XX:+UnlockDiagnosticVMOptions -XX:+ClassUnloading -XX:+UseG1GC"

export SLACK_CHANNEL=""
export DATADOG_METRICS_FILE="$METRICS_BASE_DIR/datadog-report-$CURRENT_JOB_NAME.json"
export SLACK_METRICS_FILE="$METRICS_BASE_DIR/slack-report-$CURRENT_JOB_NAME.txt"
export TELEGRAF_METRICS_FILES=""

# Flush metrics every 3 seconds because we have shorter test durations
export CSV_REPORTING_INTERVAL="3s"

# If you want finer grained DEBUG level logging, uncomment this
# export LOG_LEVEL_CANTON=DEBUG

# Shorten durations for quick local verification
TEST_WITH_REPLICATED_DB_DURATION=10
TEST_WITH_REPLICATED_DB_DURATION_UNIT=seconds

TEST_WITH_FAST_DB_DURATION=10
TEST_WITH_FAST_DB_DURATION_UNIT=seconds

TEST_WITH_BIG_COMMANDS_DURATION=10
TEST_WITH_BIG_COMMANDS_DURATION_UNIT=seconds

RECORDING_DURATION=10
RECORDING_DURATION_UNIT=seconds
