module Triparty.Settle where

import Triparty.Asset
import DA.Map
import DA.Foldable 
import DA.Optional

data Movement = Movement with from : Party, fromAccount : Text, to : Party, toAccount: Text, id : Text, qty : Decimal deriving (Eq, Show)

type AssetWithCid = (ContractId Asset, Asset)

-- (asset id, owner, account) -> list of instances and their qty
type AssetMap = Map (Text, Party, Text) [AssetWithCid]

-- map movement to a tuple suitable for aggregation
movementToTuple : Movement -> ((Party, Text, Party, Text, Text), Decimal)
movementToTuple m 
  | (m.from, m.fromAccount) < (m.to, m.toAccount) = ((m.from, m.fromAccount, m.to, m.toAccount, m.id), m.qty)
  | otherwise = ((m.to, m.toAccount, m.from, m.fromAccount, m.id), (-1.0) * m.qty)

tupleToMovement : ((Party, Text, Party, Text, Text), Decimal) -> Movement
tupleToMovement ((a, a_acc, b, b_acc, asset_id), qty)
  | qty > 0.0 = Movement with from = a, fromAccount = a_acc, to = b, toAccount = b_acc, id = asset_id, qty = qty
  | otherwise = Movement with from = b, fromAccount = b_acc, to = a, toAccount = a_acc, id = asset_id, qty = - qty
 
mapToMovement : Map (Party, Text, Party, Text, Text) Decimal -> [Movement]
mapToMovement m = map tupleToMovement (DA.Map.toList m)

-- this will compute the net movement for a list of movements
computeNetMovement: [Movement] -> [Movement]
computeNetMovement movements = Prelude.filter (\m -> m.qty /= 0.0) (mapToMovement (fromListWithL (+) (map movementToTuple movements)))

-- returns a map from (owner, asset id) to a list of instances and their qty
computeAssetMap : [ContractId Asset] -> Update AssetMap
computeAssetMap assetCids = do
    -- TODO make me fast and validate issuers
    assets <- mapA fetch assetCids
    let assetWithCid = zip assetCids assets
    return (fromListWithL (++) [( (a.id, a.owner, a.account), [(cid, a)]) | (cid, a) <- assetWithCid])

-- returns issuer, src assets and target assets (for utxo compaction)
lookupAssets : Movement -> AssetMap -> ([AssetWithCid], [AssetWithCid])
lookupAssets movement assetMap = do
  let sourceAssets = case DA.Map.lookup (movement.id, movement.from, movement.fromAccount) assetMap of 
        Some (assets) -> assets
        _ -> error ("Source asset " <> show movement.id <> " of " <> show movement.from <> " not found")
  let targetAssets = fromOptional [] $ DA.Map.lookup (movement.id, movement.to, movement.toAccount) assetMap 
  (sourceAssets, targetAssets)

type MovementWithAssets = (Movement, [ContractId Asset], [ContractId Asset])
-- (a, b) -> list of movements
type MovementGroup = Map (Party, Party) [MovementWithAssets]

movementToGroupKey : Movement -> AssetMap -> ((Party, Party), [MovementWithAssets])
movementToGroupKey m assetMap = 
   let 
     (srcAssets, targetAssets) = lookupAssets m assetMap      
     (a, b) = if m.from < m.to then (m.from, m.to) else (m.to, m.from)
     in ((a, b), [(m, map fst srcAssets, map fst targetAssets)])

-- group movement by from, to
groupMovements : [Movement] -> AssetMap -> MovementGroup
groupMovements movements assetMap = fromListWithL (++) (map (`movementToGroupKey` assetMap) movements)

transferAssets: MovementWithAssets -> Update ()
transferAssets (movement, [], _) = abort ("No source assets for movement: " <> show movement)
transferAssets (movement, sid :: rest, targetAssets) = do 
  _ <- exercise sid DirectTransfer with
      newOwner = movement.to
      newAccount = movement.toAccount
      transferQty = movement.qty
      viewer = movement.from
      otherSrc = rest
      target = targetAssets
  return ()
   

template SettlementApp 
  with
    registry : Party
  where 
    signatory registry
    
    nonconsuming choice BatchTransfer : ()
      with 
        movements : [MovementWithAssets]
        auth : [Party]
      controller auth
      do
        forA_ movements transferAssets
                
    nonconsuming choice Settle : ()
      with 
        movements : [Movement]
        assetCids : [ContractId Asset]
        auth : [Party]        
      controller auth
      do         
        assetMap <- computeAssetMap assetCids
        let netMovement = computeNetMovement movements        
        let movementGroups = groupMovements netMovement assetMap
        forA_ (DA.Map.toList movementGroups) $ \((a, b), movementsWithAssets) -> do
          exercise self BatchTransfer with 
            movements = movementsWithAssets
            auth = [a, b]            