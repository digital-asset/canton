module Triparty.Bootstrap where
-- 
-- Utility templates to bootstrap the triparty test
---

import Triparty.Asset
import Triparty.Settle
import Triparty.TriPartyAgreement
import DA.List
import DA.Foldable 
import DA.Either
import DA.Optional
import DA.Action (foldlA)

computeObserverForNextStep : [Party] -> [Party] -> Party -> Party
computeObserverForNextStep (agent :: _) _ _ = agent
computeObserverForNextStep [] (taker :: _) _ = taker
computeObserverForNextStep [] [] last = last

computeAssetIds : Int -> Int -> [Text]
computeAssetIds issuerIndex numAssets = [ "A.i" <> show issuerIndex <> ".n" <> show j | j <- [0..(numAssets-1)]]

mkAccountId : Int -> Int -> Int -> Int -> Text
mkAccountId custodian register issuer account = "acc.u" <> show custodian <> ".r" <> show register <> ".i" <> show issuer <> ".a" <> show account

crossProduct : [a] -> [b] -> [c] -> [(a, b, c)]
crossProduct xs ys zs = [(x, y, z) | x <- xs, y <- ys, z <- zs]

zipWithIndex : [a] -> [(a, Int)]
zipWithIndex xs = zip xs [0..(DA.List.length xs - 1)]

template Debug 
  with 
    actor : Party 
    message : Text
  where 
    signatory actor  



template RegistryData
  with 
    registry : Party 
    subregisters : [(Party, ContractId SubRegister, ContractId SettlementApp)]
    observers : [Party]
  where
    signatory registry
    observer observers

template ForceAccept
  with
    registry : Party
    forced : Party
  where
    signatory registry, forced

    nonconsuming choice ForceAcceptTriPartyAgreement : Either (ContractId TriPartyAgreementProposal) (ContractId TriPartyAgreement)
      with
        cid : ContractId TriPartyAgreementProposal
      controller registry
      do
        exercise cid AcceptTriPartyAgreementProposal with auth = forced       

    nonconsuming choice ForceMint : ([ContractId Asset], ContractId Registry)
      with
        registryCid : ContractId Registry
        requests : [ContractId MintRequest]
      controller registry
      do
        exercise registryCid Mint with requests = requests

    nonconsuming choice ForceCreateMintRequest : ContractId BootstrapAsset
      with     
        request : MintRequest
        force : ContractId ForceAccept
        subregister: Party
        subregisterCid: ContractId SubRegister
      controller registry
      do
        create BootstrapAsset with registry = registry, request = request, force = force, subregister = subregister, subregisterCid = subregisterCid


type CashIssuerInfo = (Party, ContractId ForceAccept)
type IssuerInfo = (Party, ContractId ForceAccept)
type AgentInfo = (Party, ContractId ForceAccept)
type SubregisterInfo = (Party, ContractId SubRegister)
type TakerInfo = (Party, ContractId ForceAccept)

template PreBootstrap
  with
    registry : Party
    cashIssuer : Optional CashIssuerInfo
    issuers : [IssuerInfo]
    agents : [AgentInfo]
    subregisters : [SubregisterInfo]
    takers : [TakerInfo]
    numAgents : Int
    numAssetsPerIssuer : Int 
    numAccountsPerIssuer: Int        
  where 
    signatory registry

    choice AddCashIssuer : ContractId PreBootstrap
      with
        cashIssuer : Party
      controller cashIssuer
      do        
        create Registry with registry = registry, issuer = cashIssuer, id = cashId, outstanding = 0.0
        fa <- create ForceAccept with registry = registry, forced = cashIssuer
        create this with cashIssuer = Some (cashIssuer, fa)

    choice AddIssuer : ContractId PreBootstrap
      with
        issuer : Party
      controller issuer
      do
        let assetIds = computeAssetIds (DA.List.length issuers) numAssetsPerIssuer
        forA_ assetIds (\id -> create Registry with registry = registry, issuer = issuer, id = id, outstanding = 0.0)
        fa <- create ForceAccept with registry = registry, forced = issuer
        create this with issuers = issuers ++ [(issuer,fa)]

    choice AddAgent : ContractId PreBootstrap
      with
        agent : Party
      controller agent
      do
        assertMsg "Agent already added" (agent `notElem` (map fst agents))
        assertMsg "Cannot add more agents than specified" (DA.List.length agents < numAgents)
        fa <- create ForceAccept with registry = registry, forced = agent
        create this with agents = agents ++ [(agent, fa)]

    choice AddSubregister : ContractId PreBootstrap
      with
        subregister : Party
      controller subregister
      do
        assertMsg "Subregister already added" (subregister `notElem` (map fst subregisters))
        assertMsg "Cannot add more subregisters than specified" (DA.List.length subregisters < numAgents)
        sb <- create SubRegister with registry = registry, subRegistry = subregister
        create SettlementApp with registry = subregister
        create this with subregisters = subregisters ++ [(subregister, sb)]

    choice AddTaker : ContractId PreBootstrap
      with
        taker : Party
      controller taker
      do
        assertMsg "Taker already added" (taker `notElem` (map fst takers))
        assertMsg "Cannot add more takers than specified" (DA.List.length takers < numAgents)
        fa <- create ForceAccept with registry = registry, forced = taker
        create this with takers = takers ++ [(taker, fa)]

    choice ReadyForBootstrap : ContractId Bootstrap 
      controller registry
      do
        let cashIssuerS = fromSome cashIssuer
        assertMsg "Not enough agents" (DA.List.length agents == numAgents)
        assertMsg "Not enough takers" (DA.List.length takers == numAgents)
        assertMsg "Not enough subregisters" (DA.List.length subregisters == numAgents)
        assertMsg "Not enough issuers" (not (DA.List.null issuers))        
        create Bootstrap with
          registry = registry
          cashIssuer = cashIssuerS
          issuers = issuers
          agents = agents
          subregisters = subregisters
          takers = takers
          numAssetsPerIssuer = numAssetsPerIssuer
          numAccountsPerIssuer = numAccountsPerIssuer      
          custodianIndex = 0

template Bootstrap
  with
    registry : Party
    cashIssuer : CashIssuerInfo
    issuers : [IssuerInfo]
    agents : [AgentInfo]
    subregisters : [SubregisterInfo]
    takers : [TakerInfo]    
    numAssetsPerIssuer : Int 
    numAccountsPerIssuer: Int 
    custodianIndex : Int
  where
    signatory registry

    choice AddCustodian : ()
      with
        custodian : Party
      controller custodian
      do        
        _ <- create this with custodianIndex = custodianIndex + 1
        let iterateOver = crossProduct (zipWithIndex (zip3 subregisters agents takers)) (zipWithIndex issuers) [0..(numAccountsPerIssuer - 1)]
        forA_ iterateOver (bootstrapCustodianAccount registry custodianIndex custodian numAssetsPerIssuer cashIssuer)
        

bootstrapCustodianAccount: Party -> Int -> Party -> Int -> CashIssuerInfo -> (((SubregisterInfo, AgentInfo, TakerInfo), Int), (IssuerInfo, Int), Int) -> Update (ContractId BootstrapCustodianAccount)
bootstrapCustodianAccount registry custodianIndex custodian numAssetsPerIssuer cashIssuer (((subregister, agent, taker), sIdx), (issuer, iIdx), accountIndex) = do  
  create BootstrapCustodianAccount with
    registry = registry
    custodian = custodian
    custodianIndex = custodianIndex
    numAssetsPerIssuer = numAssetsPerIssuer
    cashIssuer = cashIssuer
    subregister = subregister
    agent = agent
    taker = taker
    subregisterIndex = sIdx
    issuer = issuer
    issuerIndex = iIdx
    accountIndex = accountIndex

template BootstrapAsset
  with 
    registry : Party     
    request : MintRequest
    force : ContractId ForceAccept
    subregister: Party
    subregisterCid: ContractId SubRegister
  where 
    signatory request.owner, registry

    nonconsuming choice BatchApprove : ()
      with 
        registryCid : ContractId Registry
        other : [ContractId BootstrapAsset]
      controller registry
      do
        foldlA (\acc item -> do
          ret <- exercise item Approve with registryCid = acc
          return (snd ret)) registryCid (self :: other)                    
        return ()        

    choice Approve : (ContractId Asset, ContractId Registry)
      with
        registryCid : ContractId Registry      
      controller registry
      do        
        -- create the mint request
        mr <- create request
        -- mint the asset        
        (assets, registryCid) <- exercise force ForceMint with registryCid = registryCid, requests = [mr]
        -- transfer it to the subregister
        reassigned <- exercise subregisterCid Reassign with assetCid = head assets, newRegister = subregister, owner = request.owner          
        return (reassigned, registryCid)

template BootstrapCustodianAccount
  with 
    registry : Party
    custodian : Party
    custodianIndex : Int     
    numAssetsPerIssuer : Int 
    cashIssuer : CashIssuerInfo
    subregister : SubregisterInfo
    agent : AgentInfo
    taker : TakerInfo
    subregisterIndex : Int
    issuer : IssuerInfo
    issuerIndex : Int
    accountIndex : Int
  where
    signatory custodian, registry

    choice ProcessBootstrap : ()
      controller registry
      do
        let accountId = mkAccountId custodianIndex subregisterIndex issuerIndex accountIndex
        let assetIds = computeAssetIds issuerIndex numAssetsPerIssuer                
        let (subregisterParty, subregisterCid) = subregister
        let (takerParty, takerFA) = taker        
        let (agentParty, forceAgent) = agent
        let (cashIssuerParty, forceCashIssuer) = cashIssuer
        let (issuerParty, forceIssuer) = issuer
        -- create asset requests for this account        
        forA_ assetIds (\assetId -> do
          let request = MintRequest with issuer = issuerParty, id = assetId, qty = 100.0, owner = custodian, account = accountId, viewer = custodian
          create BootstrapAsset with registry = registry, request = request, force = forceIssuer, subregister = subregisterParty, subregisterCid = subregisterCid)

        -- create cash for this account (initially with asset taker), we put it here to so we don't have contention
        -- in the real world, the cash disclosure would need to be handled separately
        let cashRequest = (MintRequest with issuer = cashIssuerParty, id = cashId, qty = 1000000.0, owner = takerParty, account = accountId, viewer = custodian)
        exercise takerFA ForceCreateMintRequest with request = cashRequest, force = forceCashIssuer, subregister = subregisterParty, subregisterCid = subregisterCid
                        
        -- create an eligibility list for the assets 
        let eligibility = map (\(assetId, index) -> (assetId, 100.0 + intToDecimal index)) (zipWithIndex assetIds)
        -- create tri-party agreemnt
        proposal <- create TriPartyAgreementProposal with agent = agentParty, collateralGiver = custodian, collateralTaker = takerParty, account = accountId, eligibility = eligibility, signed = []
        proposal1 <- fromLeft proposal <$> exercise forceAgent ForceAcceptTriPartyAgreement with cid = proposal
        exercise takerFA ForceAcceptTriPartyAgreement with cid = proposal1
        return ()
        
        
