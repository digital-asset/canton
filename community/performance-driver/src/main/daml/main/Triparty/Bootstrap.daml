module Triparty.Bootstrap where
--
-- Utility templates to bootstrap the triparty test
---

import Triparty.Asset
import Triparty.Settle
import Triparty.TriPartyAgreement
import DA.List
import DA.Foldable
import DA.Optional
import DA.Action

computeObserverForNextStep : [Party] -> [Party] -> Party -> Party
computeObserverForNextStep (agent :: _) _ _ = agent
computeObserverForNextStep [] (taker :: _) _ = taker
computeObserverForNextStep [] [] last = last

computeAssetIds : Int -> Int -> [Text]
computeAssetIds issuerIndex numAssets = [ "A.i" <> show issuerIndex <> ".n" <> show j | j <- [0..(numAssets-1)]]

mkAccountId : Int -> Int -> Int -> Int -> Text
mkAccountId custodian register issuer account = "acc.u" <> show custodian <> ".r" <> show register <> ".i" <> show issuer <> ".a" <> show account

crossProduct : [a] -> [b] -> [c] -> [(a, b, c)]
crossProduct xs ys zs = [(x, y, z) | x <- xs, y <- ys, z <- zs]

zipWithIndex : [a] -> [(a, Int)]
zipWithIndex xs = zip xs [0..(DA.List.length xs - 1)]

template Debug
  with
    actor : Party
    message : Text
  where
    signatory actor



template RegistryData
  with
    registry : Party
    subregisters : [(Party, ContractId SubRegister, ContractId SettlementApp)]
    observers : [Party]
  where
    signatory registry
    observer observers

template ForceAccept
  with
    registry : Party
    forced : Party
  where
    signatory registry, forced

    nonconsuming choice ForceAcceptAccount : ContractId BootstrapUserAccount
      with
        cid : ContractId BootstrapUserAccount
      controller registry
      do
        exercise cid AddSignature with signer = forced


type CashIssuerInfo = Party
type IssuerInfo = Party
type AgentInfo = (Party, ContractId ForceAccept)
type SubregisterInfo = (Party, ContractId ForceAccept)
type TakerInfo = (Party, ContractId ForceAccept)

template PreBootstrap
  with
    registry : Party
    cashIssuer : Optional CashIssuerInfo
    issuers : [IssuerInfo]
    agents : [AgentInfo]
    subregisters : [SubregisterInfo]
    takers : [TakerInfo]
    numAgents : Int
    numAssetsPerIssuer : Int
    numAccountsPerIssuer: Int
    capNumCounterparties : Int
  where
    signatory registry, (map fst subregisters)

    choice AddCashIssuer : ContractId PreBootstrap
      with
        cashIssuerParty : Party
      controller cashIssuerParty
      do
        assertMsg "Cash issuer already added" (isNone cashIssuer)
        create Registry with registry = registry, issuer = cashIssuerParty, id = cashId, outstanding = 0.0
        create this with cashIssuer = Some (cashIssuerParty)

    choice AddIssuer : ContractId PreBootstrap
      with
        issuer : Party
      controller issuer
      do
        assertMsg "Issuer already added" (issuer `notElem` (issuers))
        assertMsg "Already at capacity for issuers" (DA.List.length issuers < numAgents)
        let assetIds = computeAssetIds (DA.List.length issuers) numAssetsPerIssuer
        forA_ assetIds (\id -> create Registry with registry = registry, issuer = issuer, id = id, outstanding = 0.0)
        create this with issuers = issuers ++ [(issuer)]

    choice AddAgent : ContractId PreBootstrap
      with
        agent : Party
      controller agent
      do
        assertMsg "Agent already added" (agent `notElem` (map fst agents))
        assertMsg "Already at capacity for agents" (DA.List.length agents < numAgents)
        fa <- create ForceAccept with registry = registry, forced = agent
        create this with agents = agents ++ [(agent, fa)]

    choice AddSubregister : ContractId PreBootstrap
      with
        subregister : Party
      controller subregister
      do
        assertMsg "Subregister already added" (subregister `notElem` (map (\x -> x._1) subregisters))
        assertMsg "Already at capacity for subregisters" (DA.List.length subregisters < numAgents)
        sb <- create SubRegister with registry = registry, subRegistry = subregister
        fa <- create ForceAccept with registry = registry, forced = subregister
        create this with subregisters = subregisters ++ [(subregister, fa)]

    choice AddTaker : ContractId PreBootstrap
      with
        taker : Party
      controller taker
      do
        assertMsg "Taker already added" (taker `notElem` (map fst takers))
        assertMsg "Already at capacity for takers" (DA.List.length takers < numAgents)
        fa <- create ForceAccept with registry = registry, forced = taker
        create this with takers = takers ++ [(taker, fa)]

    choice ReadyForBootstrap : ContractId Bootstrap
      controller registry
      do
        let cashIssuerS = fromSome cashIssuer
        assertMsg "Not enough agents" (DA.List.length agents == numAgents)
        assertMsg "Not enough takers" (DA.List.length takers == numAgents)
        assertMsg "Not enough subregisters" (DA.List.length subregisters == numAgents)
        assertMsg "Not enough issuers" (not (DA.List.null issuers))
        create Bootstrap with
          registry = registry
          cashIssuer = cashIssuerS
          issuers = (sort issuers)
          agents = (sortOn fst agents)
          subregisters = (sortOn fst subregisters)
          takers = (sortOn fst takers)
          numAssetsPerIssuer = numAssetsPerIssuer
          numAccountsPerIssuer = numAccountsPerIssuer
          userIndex = 0
          capNumCounterparties = capNumCounterparties

capList : Int -> Int -> [a] -> [a]
capList _ _ [] = []
capList cap start xs = if cap <= DA.List.length xs then DA.List.take cap (DA.List.drop (start % DA.List.length xs) (xs ++ xs)) else xs

template Bootstrap
  with
    registry : Party
    cashIssuer : CashIssuerInfo
    issuers : [IssuerInfo]
    agents : [AgentInfo]
    subregisters : [SubregisterInfo]
    takers : [TakerInfo]
    numAssetsPerIssuer : Int
    numAccountsPerIssuer: Int
    userIndex : Int
    capNumCounterparties : Int
  where
    signatory registry, (map fst subregisters)

    choice AddUser : ContractId Bootstrap
      with
        user : Party
      controller user
      do
        forA_ (map fst subregisters) $ \subregister -> do
          create SettlementApp with registry = subregister, user = user
        _ <- create BootstrapUser with
          user = user
          registry = registry
          cashIssuer = cashIssuer
          issuers = issuers
          agents = (capList capNumCounterparties userIndex agents)
          subregisters = (capList capNumCounterparties userIndex subregisters)
          takers = (capList capNumCounterparties userIndex takers)
          numAssetsPerIssuer = numAssetsPerIssuer
          numAccountsPerIssuer = numAccountsPerIssuer
          userIndex = userIndex
          batchOffset = 0
        create this with userIndex = userIndex + 1

template BootstrapUser
  with
    user : Party
    registry : Party
    cashIssuer : CashIssuerInfo
    issuers : [IssuerInfo]
    agents : [AgentInfo]
    subregisters : [SubregisterInfo]
    takers : [TakerInfo]
    numAssetsPerIssuer : Int
    numAccountsPerIssuer: Int
    userIndex : Int
    batchOffset : Int
  where
    signatory registry, (map fst subregisters), user

    choice ProcessBatch : ()
      with
        count : Int
      controller registry
        do
          assertMsg "Count must be positive" (count > 0)
          let iterateOver = crossProduct (zipWithIndex (zip3 subregisters agents takers)) (zipWithIndex issuers) [0..(numAccountsPerIssuer - 1)]
          let chunk = DA.List.take count (DA.List.drop batchOffset iterateOver)
          DA.Action.when (DA.List.length iterateOver > batchOffset + count) $ do
            create this with batchOffset = batchOffset + count
            return ()
          forA_ chunk (bootstrapUserAccount registry userIndex user numAssetsPerIssuer cashIssuer)


bootstrapUserAccount: Party -> Int -> Party -> Int -> CashIssuerInfo -> (((SubregisterInfo, AgentInfo, TakerInfo), Int), (IssuerInfo, Int), Int) -> Update ()
bootstrapUserAccount registry userIndex user numAssetsPerIssuer cashIssuer (((subregister, agent, taker), sIdx), (issuer, iIdx), accountIndex) = do
  let (subregisterParty, forceSubregister) = subregister
  let (takerParty, forceTaker) = taker
  let (agentParty, forceAgent) = agent
  bca <- create BootstrapUserAccount with
    registry = registry
    user = user
    userIndex = userIndex
    numAssetsPerIssuer = numAssetsPerIssuer
    cashIssuer = cashIssuer
    subregister = subregisterParty
    agent = agentParty
    taker = takerParty
    subregisterIndex = sIdx
    issuer = issuer
    issuerIndex = iIdx
    accountIndex = accountIndex
    signed = []
  bcb <- exercise forceSubregister ForceAcceptAccount with cid = bca
  bcc <- exercise forceTaker ForceAcceptAccount with cid = bcb
  bcd <- exercise forceAgent ForceAcceptAccount with cid = bcc
  return ()


template BootstrapUserAccount
  with
    registry : Party
    user : Party
    userIndex : Int
    numAssetsPerIssuer : Int
    cashIssuer : Party
    subregister : Party
    agent : Party
    taker : Party
    subregisterIndex : Int
    issuer : Party
    issuerIndex : Int
    accountIndex : Int
    signed : [Party]
  where
    signatory user, signed

    choice AddSignature : ContractId BootstrapUserAccount
      with
        signer : Party
      controller signer
      do
        create this with signed = signer :: signed

    choice ProcessBootstrap : ()
      controller user
      do
        let accountId = mkAccountId userIndex subregisterIndex issuerIndex accountIndex
        let assetIds = computeAssetIds issuerIndex numAssetsPerIssuer

        -- NOTE: this is a short cut. normally, the issuance would go through the
        -- mint and reassignment workflow. however, this means we start on one node and slowly
        -- start to ramp up the shards. but for the actual test, we want to be already
        -- in the sharded state. therefore, we create the assets directly in the subregister
        -- as a result, the "registry" will not show the correct amount. but c'est la vie!

        let assetQty = 100.0
        let numAssets = intToDecimal (DA.List.length assetIds)
        let cashQty = (100.0 + numAssets) * assetQty * numAssets

        -- create asset requests for this account
        forA_ assetIds (\assetId -> do
          create Asset with registry = subregister, issuer = issuer, id = assetId, qty = assetQty, owner = user, account = accountId, viewer = user)

        -- create cash for this account (initially with asset taker), we put it here to so we don't have contention
        -- in the real world, the cash disclosure would need to be handled separately
        create Asset with registry = subregister, issuer = cashIssuer, id = cashId, qty = cashQty, owner = taker, account = accountId, viewer = user

        -- create an eligibility list for the assets
        let eligibility = map (\(assetId, index) -> (assetId, 100.0 + intToDecimal index)) (zipWithIndex assetIds)
        -- create tri-party agreement
        proposal <- create TriPartyAgreement with agent = agent, collateralGiver = user, collateralTaker = taker, account = accountId, eligibility = eligibility, amount = 0.0
        return ()


