-- An interface, in its own package as upgrades require; implemented in corpus-interfaces-model.
module Holding where

data HoldingView = HoldingView with owner : Party; amount : Decimal

interface Holding where
  viewtype HoldingView
  setAmount : Decimal -> Update (ContractId Holding)

  choice Scale : ContractId Holding
    with
      factor : Decimal
    controller (view this).owner
    do setAmount this ((view this).amount * factor)

  nonconsuming choice Amount : Decimal
    controller (view this).owner
    do pure (view this).amount
