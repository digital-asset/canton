module Uint256Mod {

  record @serializable Box = { x: Uint256, party: Party } ;

  template (this : Box) =  {
    precondition True;
    signatories (PartyMod:one (Uint256Mod:Box {party} this));
    observers (Nil @Party);
  };

  val zero: Uint256 = 0x0;
  val one: Uint256 = 0x1;
  val ff: Uint256 = 0xFF;

  val equal: Uint256 -> Uint256 -> Bool = EQUAL @Uint256;

}
