module UnpackMod {

  val unpackTemplate: ContractId TemplateMod:Person -> Update TemplateMod:Person =
    \(cid: ContractId TemplateMod:Person) ->
      unpack_template @TemplateMod:Person cid;

  val unpackInterface: ContractId InterfaceExtMod:Boxy -> Update InterfaceExtMod:Boxy =
    \(cid: ContractId InterfaceExtMod:Boxy) ->
      unpack_interface @InterfaceExtMod:Boxy cid;

}
