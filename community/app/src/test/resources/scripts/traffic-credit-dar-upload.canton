// Without Daml top-ups the participant does not load the canton-traffic-credit DAR, so upload the one bundled in the release
val trafficCreditDar = "community/app/target/release/canton/dars/canton-traffic-credit-1.0.0.dar"
def trafficCreditPackages = participant1.packages.list(filterName = "canton-traffic-credit")

require(
  trafficCreditPackages.isEmpty,
  "Traffic credit DAR should not have been loaded automatically",
)
participant1.dars.upload(trafficCreditDar, vetAllPackages = false)
require(trafficCreditPackages.nonEmpty, "Traffic credit DAR was not uploaded")
println("Bundled traffic credit DAR was uploaded.")
// TODO(i7023) remove stop again
nodes.local.stop()
sys.exit(0)
