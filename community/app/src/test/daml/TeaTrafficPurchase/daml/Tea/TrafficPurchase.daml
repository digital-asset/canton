-- | Simplified wallet contract that sells traffic, used to test `TrafficCreditReporter_PublishCredit`
-- composed into an application's purchase logic.
--
-- Mirrors the shape of a real wallet integration, but pays with a local `Token`
-- instead of CIP-56 holdings, so it does not depend on the token standard.
--
-- NOTE: This is a test-only contract, and should not be used in production!
module Tea.TrafficPurchase where

import Canton.Api.Traffic.CreditV1
  ( emptyMetadata
  , TrafficCreditReporter_PublishCredit(..)
  , TrafficCreditReporter_PublishCreditResult(..)
  , TrafficCreditReporter
  , TrafficCreditReporterView(..)
  )

import DA.Foldable (forA_)
import DA.Text qualified as T

-- | A minimal fungible asset used as payment.
template Token
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory issuer
    observer owner
    ensure amount > 0.0

    choice Token_Transfer : ContractId Token
      with
        newOwner : Party
      controller owner
      do create this with owner = newOwner

-- | Outcome of a purchase.
data TrafficPurchasedResult = TrafficPurchasedResult with
    accountId : Text
      -- ^ The account credited with traffic.
    amount : Int
      -- ^ The amount of traffic credited
    payment : ContractId Token
      -- ^ The token now owned by the paymaster's receiver.
  deriving (Show, Eq)

-- | Sells traffic at a fixed rate, paid for with `Token`s of `issuer`.
--
-- Purchasers are not stakeholders: the paymaster discloses this contract to them.
template TrafficPurchaser
  with
    paymaster : Party
    paymasterReceiver : Party
    issuer : Party
    conversionRate : Decimal
      -- ^ Traffic bytes per unit of token.
  where
    signatory paymaster
    ensure conversionRate > 0.0

    interface instance TrafficCreditReporter for TrafficPurchaser where
      view = TrafficCreditReporterView with paymaster; meta = emptyMetadata
      trafficCreditReporter_publishCreditImpl _self arg =
        either abort pure (validatePublishCredit arg)

    nonconsuming choice TrafficPurchaser_PurchaseCredits : TrafficPurchasedResult
      with
        purchaser : Party
        targetAccount : Text
        tokenCid : ContractId Token
      controller purchaser
      do
        accountId <- either abort pure (validateAccountId targetAccount)

        token <- fetch tokenCid
        assertMsg "token is not owned by the purchaser" (token.owner == purchaser)
        assertMsg "token is not issued by the accepted issuer" (token.issuer == issuer)

        let trafficAmount = floor (token.amount * conversionRate)
        assertMsg "purchase buys no traffic" (trafficAmount > 0)

        payment <- exercise tokenCid Token_Transfer with newOwner = paymasterReceiver

        -- Runs with the paymaster's authority, as the paymaster signs this contract
        _ <- exercise (toInterfaceContractId @TrafficCreditReporter self)
          TrafficCreditReporter_PublishCredit with
            accountId
            trafficAmount
            purchaser
            observers = [purchaser]
            metadata = emptyMetadata

        pure TrafficPurchasedResult with accountId; amount = trafficAmount; payment

-- | Credits traffic directly, without a purchase.
template CreditIssuer
  with
    paymaster : Party
  where
    signatory paymaster

    interface instance TrafficCreditReporter for CreditIssuer where
      view = TrafficCreditReporterView with paymaster; meta = emptyMetadata
      trafficCreditReporter_publishCreditImpl _self arg =
        either abort pure (validatePublishCredit arg)

validatePublishCredit : TrafficCreditReporter_PublishCredit -> Either Text TrafficCreditReporter_PublishCreditResult
validatePublishCredit arg = do
  _ <- validateAccountId arg.accountId
  if arg.trafficAmount > 0
    then Right TrafficCreditReporter_PublishCreditResult {}
    else Left "trafficAmount must be positive"

validateAccountId : Text -> Either Text Text
validateAccountId value
  | len > 255 = Left ("Account id must be at most 255 characters, found " <> show len)
  | otherwise = value <$ forA_ (T.splitOn "/" value) validateSegment
  where
    len = T.length value

validateSegment : Text -> Either Text ()
validateSegment segment
  | segment == "" = Left "Account id segments must not be empty"
  | T.isPred isSegmentChar segment = Right ()
  | otherwise =
      Left ("Account id segments must only contain [A-Za-z0-9@^$.!`#+'~_|:() -], found " <> show segment)
  where
    isSegmentChar c = T.isAlphaNum c || c `elem` segmentPunctuation

segmentPunctuation : [Text]
segmentPunctuation = T.explode "@^$.!`-#+'~_|:() "
