// -----------------------------------------------------------
// load jar
// -----------------------------------------------------------

// dummy main so that this script complies with the expectation of canton-base
def main() = ()

Seq("performance-driver_", "performance_").foreach { jar =>
  os.walk(os.Path(".", base = os.pwd))
    .filter(x => x.ext == "jar" && x.baseName.startsWith(jar))
    .sorted
    .lastOption match {
    case Some(jar) =>
      logger.info(s"Loading $jar")
      println(s"Loading $jar")
      interp.load.cp(jar)
    case None =>
      println(
        s"No $jar found by walking pwd. If you haven't included in the classpath, then you will likely start to see errors. Lots of errors."
      )
  }
}

// adding a @ will make the imports available
@

com.digitalasset.canton.util.Mutex.MaxSpins.set(60000)
com.digitalasset.canton.util.Mutex.TrackContention.set(true)

import com.digitalasset.canton.performance.scenarios.TransferTesting
val runType = "triparty"
val issuersPerNode = 3

val master = TransferTesting.startupMaster(
  runType = runType,
  issuersPerNode = issuersPerNode,
  reportFrequency = 2500,
)

val runners = TransferTesting.startupParticipants(
  ignoreParticipants = Set("opsparticipant"),
  runType = runType,
  issuersPerNode = issuersPerNode,
)

def stats() =
  println((master +: runners).flatMap(_.status()).map(_.toString).mkString("\n"))

def phase() = {
  val kk = "daml.participant.phase.duration.seconds"
  val rr = participant1.metrics.list(kk).getOrElse(kk, List.empty)
  val tmp = rr
    .map { mv =>
      val pp = participant1.metrics.get_exponential_histogram(kk, mv.attributes)
      (
        mv.attributes.getOrElse("phase", "unknown"),
        pp.sum / Math.max(pp.count, 1),
        pp.sum,
        pp.count,
      )
    }
    .sortBy(-_._2)
    .map { case (phase, avg, sum, count) =>
      s"$phase: avg=$avg, sum=$sum, count=$count"
    }
  println(tmp.mkString("\n"))
}

def sequencer_client(
    instances: com.digitalasset.canton.console.LocalInstanceReference*
)(waitMillis: Long = 2000L) =
  instances.map { instance =>
    val pre =
      instance.metrics.get_long_point("daml.sequencer-client.handler.sequencer-events").value
    com.digitalasset.canton.concurrent.Threading.sleep(waitMillis)
    val post =
      instance.metrics.get_long_point("daml.sequencer-client.handler.sequencer-events").value
    (instance.name, (post - pre) / (waitMillis / 1000))
  }
